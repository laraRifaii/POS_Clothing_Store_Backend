
DATABASE_URL="file:./prisma/pos.db"
NODE_ENV=production

# Port the API listens on. The frontend's BACKEND_URL must use the same port.
PORT=5000

# Network interface to bind to. 127.0.0.1 = this machine only (recommended).
# Needs: app.listen(PORT, process.env.HOST ?? '127.0.0.1') in src/main.ts
HOST=127.0.0.1
UPLOAD_PATH=./uploads
